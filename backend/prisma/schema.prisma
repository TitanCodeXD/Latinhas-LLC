// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


//Model das demandas
model Demand {
  id           Int       @id @default(autoincrement())
  sku          String
  description    String?
  totalPlan Int
  totalProd    Int        @default(0)
  periodoId    Int
  periodo      Periodo    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
}

//Periodo
model Periodo {
  id           Int        @id @default(autoincrement())
  startDate   DateTime
  endDate      DateTime
  totalPlan Int
  totalProd    Int         @default(0)
  status       Status      @default(PLANEJAMENTO)
  demands     Demand[]    
  createdAt    DateTime    @default(now())
}

// Fixos
enum Status {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
}


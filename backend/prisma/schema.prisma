// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


//Model das demandas
model Demand {
  id           Int      @id @default(autoincrement()) // chave interna
  sku          String   @unique                      // SKU (id do item)
  startDate    DateTime
  endDate      DateTime
  totalPlanned Float     // toneladas com decimal
  status       Status    @default(PLANEJAMENTO)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  description  String?
}

// Fixos
enum Status {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
}

